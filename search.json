---
layout: none
---
[
{% for entry in site.data.searchable_headings %}
  {
    "title": {{ entry.name | jsonify }},
    "url": "{{ site.baseurl }}{{ entry.url }}{% if entry.anchor != '' %}#{{ entry.anchor }}{% endif %}",
    "collection": {{ entry.collection | jsonify }},
    "content": {{ entry.description | jsonify }}
  }{% if forloop.last %}{% if site.data.searchable_skills.size > 0 or site.data.searchable_combat_skills.size > 0 or site.data.searchable_familiars.size > 0 %},{% endif %}{% else %},{% endif %}
{% endfor %}
{% if site.data.searchable_skills.size > 0 %}
{% for skill in site.data.searchable_skills %}
  {
    "title": {{ skill.name | jsonify }},
    "url": "{{ site.baseurl }}/RulesCharacter/skills.html#skill-{{ skill.id }}",
    "collection": "skills",
    "content": {{ skill.description | jsonify }}
  }{% if forloop.last %}{% if site.data.searchable_combat_skills.size > 0 %},{% endif %}{% else %},{% endif %}
{% endfor %}
{% endif %}
{% if site.data.searchable_combat_skills.size > 0 %}
{% for skill in site.data.searchable_combat_skills %}
  {
    "title": {{ skill.name | jsonify }},
    "url": "{{ site.baseurl }}/RulesCharacter/skills_combat.html#skill-{{ skill.id }}",
    "collection": "combat skills",
    "content": {{ skill.description | jsonify }}
  }{% if forloop.last %}{% if site.data.searchable_familiars.size > 0 %},{% endif %}{% else %},{% endif %}
{% endfor %}
{% endif %}
{% if site.data.searchable_familiars.size > 0 %}
{% for familiar in site.data.searchable_familiars %}
  {
    "title": {{ familiar.name | jsonify }},
    "url": "{{ site.baseurl }}/RulesMagic/familiars.html#{{ familiar.anchor }}",
    "collection": "familiars",
    "content": {{ familiar.description | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
{% endif %}
]
